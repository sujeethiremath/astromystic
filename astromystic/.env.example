# ==============================================================================
# AstroMystic - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env or .env.local containing real keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
# Base URL for customer redirection, dashboard links, and metadata
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Public / Browser)
# Found in Firebase Console -> Project Settings -> General -> Your Apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Server-Side Only - Confidential)
# Found in Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
# ------------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Format: Keep the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
# If setting in Vercel or environment file, newline characters should be represented as \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Stripe Payments Configuration (Server-Side Only - Confidential)
# ------------------------------------------------------------------------------
# Stripe Secret Key (sk_test_... for development, sk_live_... for production)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (whsec_... obtained from Stripe CLI or Dashboard Webhook settings)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# Resend Email Delivery Configuration (Server-Side Only - Confidential)
# ------------------------------------------------------------------------------
# Resend API Key (re_...)
RESEND_API_KEY=re_your_resend_api_key

# Email address where contact form inquiries should be delivered
CONTACT_EMAIL=contact@yourdomain.com

# Reply-To address for client notifications and booking receipts
ADMIN_REPLY_TO_EMAIL=support@yourdomain.com

# ------------------------------------------------------------------------------
# Administrator Access (Server-Side Only - Confidential)
# ------------------------------------------------------------------------------
# Comma-separated list of email addresses authorized for administrator dashboard access
ADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com

# ------------------------------------------------------------------------------
# Analytics (Public / Browser)
# ------------------------------------------------------------------------------
# Mixpanel Project Token
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_project_token
